# Non-secret runtime config for Perfume Manual Normalizer.
# Copy/keep equivalent values in ~/.hermes/whatsapp/perfume_manual_normalizer.env
PERFUME_NORMALIZER_GROUP=120363995412228683@g.us

# Hybrid editorial mode: cron is still no-agent/idle-cheap, but when a promo
# arrives the script calls Hermes LLM only to draft the headline. Deterministic
# code still owns product, price, cupom, trust line, link, image and formatting.
PERFUME_HEADLINE_LLM=1
PERFUME_HEADLINE_TIMEOUT=45
# Optional pin if needed later, e.g. PERFUME_HEADLINE_MODEL=<provider/model>
